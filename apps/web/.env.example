# Copia este archivo a .env.local para desarrollo, o añade la variable en
# Vercel (Project Settings → Environment Variables) para producción.

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Créalo en https://analytics.google.com — sin esta variable, GA4 no se
# carga y la analítica se queda en no-op (o en consola, en desarrollo).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
